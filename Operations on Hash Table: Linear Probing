#include <stdio.h>
#define SIZE 10

int h[SIZE];

void insert(int x) {
    int i = x % SIZE;
    int start = i;

    while(h[i] != -1) {
        i = (i+1) % SIZE;

        if(i == start) {
            printf("Hash table is full\n");
            return;
        }
    }

    h[i] = x;
    printf("Element inserted\n");
}

void search(int x) {
    int i = x % SIZE;
    int start = i;

    while(h[i] != -1) {
        if(h[i] == x) {
            printf("Element found at index %d\n", i);
            return;
        }

        i = (i+1) % SIZE;

        if(i == start)
            break;
    }

    printf("Element not found\n");
}

int main() {
    int n, x, ch;

    for(int i=0; i<SIZE; i++)
        h[i] = -1;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for(int i=0; i<n; i++) {
        scanf("%d", &x);
        insert(x);
    }

    printf("\nHash Table:\n");
    for(int i=0; i<SIZE; i++)
        printf("Index %d: %d\n", i, h[i]);

    do {
        printf("\n1.Search\n0.Exit\n");
        printf("Enter choice: ");
        scanf("%d", &ch);

        if(ch == 1) {
            printf("Enter element to search: ");
            scanf("%d", &x);
            search(x);
        }
        else if(ch != 0)
            printf("Invalid choice\n");

    } while(ch != 0);

    return 0;
}
