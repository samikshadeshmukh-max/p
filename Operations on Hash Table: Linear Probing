#include <stdio.h>
#define SIZE 10

int h[SIZE];

void insert(int x) {
    int i=x%SIZE, start=i;

    while(h[i]!=-1) {
        i=(i+1)%SIZE;
        if(i==start) {
            printf("Table full\n");
            return;
        }
    }
    h[i]=x;
}

void search(int x) {
    int i=x%SIZE, start=i;

    while(h[i]!=-1) {
        if(h[i]==x) {
            printf("Found at index %d\n",i);
            return;
        }
        i=(i+1)%SIZE;
        if(i==start) break;
    }

    printf("Not found\n");
}

int main() {
    int n,x;

    for(int i=0;i<SIZE;i++) h[i]=-1;

    printf("Number of elements: ");
    scanf("%d",&n);

    for(int i=0;i<n;i++) {
        scanf("%d",&x);
        insert(x);
    }

    printf("Hash table:\n");
    for(int i=0;i<SIZE;i++)
        printf("%d: %d\n",i,h[i]);

    printf("Search key: ");
    scanf("%d",&x);
    search(x);

    return 0;
}
