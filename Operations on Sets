#include <stdio.h>
int main() {
    int a[100], b[100], u[200], n, m, i, j, k=0, found;

    scanf("%d", &n);
    for(i=0; i<n; i++) scanf("%d", &a[i]);
    scanf("%d", &m);
    for(i=0; i<m; i++) scanf("%d", &b[i]);

    printf("Union: ");
    for(i=0; i<n; i++) u[k++]=a[i];

    for(i=0; i<m; i++) {
        found=0;
        for(j=0; j<n; j++)
            if(b[i]==a[j]) found=1;
        if(!found) u[k++]=b[i];
    }
    for(i=0; i<k; i++) printf("%d ", u[i]);

    printf("\nIntersection: ");
    for(i=0; i<n; i++)
        for(j=0; j<m; j++)
            if(a[i]==b[j]) printf("%d ", a[i]);

    printf("\nA-B: ");
    for(i=0; i<n; i++) {
        found=0;
        for(j=0; j<m; j++)
            if(a[i]==b[j]) found=1;
        if(!found) printf("%d ", a[i]);
    }

    printf("\nB-A: ");
    for(i=0; i<m; i++) {
        found=0;
        for(j=0; j<n; j++)
            if(b[i]==a[j]) found=1;
        if(!found) printf("%d ", b[i]);
    }

    printf("\nSymmetric difference: ");
    for(i=0; i<k; i++) {
        found=0;
        for(j=0; j<n; j++)
            if(u[i]==a[j]) found=1;
        for(j=0; j<m; j++)
            if(u[i]==b[j]) found=1;
        if(found) {
            int ca=0, cb=0;
            for(j=0; j<n; j++) if(u[i]==a[j]) ca=1;
            for(j=0; j<m; j++) if(u[i]==b[j]) cb=1;
            if(ca!=cb) printf("%d ", u[i]);
        }
    }
    return 0;
}
