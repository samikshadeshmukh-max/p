#include <stdio.h>

int main() {
    int a[100], b[100], n, m, i, j, found;

    printf("Enter size of set A: ");
    scanf("%d", &n);

    printf("Enter elements of set A: ");
    for(i=0; i<n; i++)
        scanf("%d", &a[i]);

    printf("Enter size of set B: ");
    scanf("%d", &m);

    printf("Enter elements of set B: ");
    for(i=0; i<m; i++)
        scanf("%d", &b[i]);

    printf("Union: ");
    for(i=0; i<n; i++)
        printf("%d ", a[i]);

    for(i=0; i<m; i++) {
        found=0;
        for(j=0; j<n; j++)
            if(b[i]==a[j])
                found=1;
        if(!found)
            printf("%d ", b[i]);
    }

    printf("\nIntersection: ");
    for(i=0; i<n; i++)
        for(j=0; j<m; j++)
            if(a[i]==b[j])
                printf("%d ", a[i]);

    printf("\nA-B: ");
    for(i=0; i<n; i++) {
        found=0;
        for(j=0; j<m; j++)
            if(a[i]==b[j])
                found=1;
        if(!found)
            printf("%d ", a[i]);
    }

    printf("\nSymmetric difference: ");
    for(i=0; i<n; i++) {
        found=0;
        for(j=0; j<m; j++)
            if(a[i]==b[j])
                found=1;
        if(!found)
            printf("%d ", a[i]);
    }

    for(i=0; i<m; i++) {
        found=0;
        for(j=0; j<n; j++)
            if(b[i]==a[j])
                found=1;
        if(!found)
            printf("%d ", b[i]);
    }

    return 0;
}
