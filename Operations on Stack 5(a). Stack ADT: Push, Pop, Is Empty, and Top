#include <stdio.h>
#define MAX 100

int stack[MAX], top = -1;

void push(int x) {
    if(top == MAX-1)
        printf("Stack overflow\n");
    else {
        stack[++top] = x;
        printf("Element pushed\n");
    }
}

void pop() {
    if(top == -1)
        printf("Stack underflow\n");
    else
        printf("Popped element: %d\n", stack[top--]);
}

void displayTop() {
    if(top == -1)
        printf("Stack is empty\n");
    else
        printf("Top element: %d\n", stack[top]);
}

void display() {
    if(top == -1) {
        printf("Stack is empty\n");
        return;
    }

    printf("Stack elements: ");
    for(int i=top; i>=0; i--)
        printf("%d ", stack[i]);
    printf("\n");
}

int main() {
    int ch, x;

    do {
        printf("\n1.Push\n2.Pop\n3.Is Empty\n4.Display Top");
        printf("\n5.Display Stack\n0.Exit\n");
        printf("Enter choice: ");
        scanf("%d", &ch);

        switch(ch) {
        case 1:
            printf("Enter element: ");
            scanf("%d", &x);
            push(x);
            break;

        case 2:
            pop();
            break;

        case 3:
            if(top == -1)
                printf("Stack is empty\n");
            else
                printf("Stack is not empty\n");
            break;

        case 4:
            displayTop();
            break;

        case 5:
            display();
            break;

        case 0:
            printf("Exiting...\n");
            break;

        default:
            printf("Invalid choice\n");
        }
    } while(ch != 0);

    return 0;
}
