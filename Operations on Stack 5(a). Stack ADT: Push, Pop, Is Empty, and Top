#include <stdio.h>
#define MAX 100

int s[MAX], top=-1;

void push(int x) {
    if(top==MAX-1) printf("Overflow\n");
    else s[++top]=x;
}

void pop() {
    if(top==-1) printf("Underflow\n");
    else printf("Popped: %d\n",s[top--]);
}

void displayTop() {
    if(top==-1) printf("Stack empty\n");
    else printf("Top: %d\n",s[top]);
}

void display() {
    for(int i=top;i>=0;i--) printf("%d ",s[i]);
    printf("\n");
}

int main() {
    int ch,x;

    do {
        printf("\n1.Push 2.Pop 3.Top 4.Empty? 5.Display 0.Exit\n");
        scanf("%d",&ch);

        switch(ch) {
        case 1: scanf("%d",&x); push(x); break;
        case 2: pop(); break;
        case 3: displayTop(); break;
        case 4: printf(top==-1?"Yes\n":"No\n"); break;
        case 5: display(); break;
        }
    } while(ch!=0);

    return 0;
}
