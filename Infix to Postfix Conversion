#include <stdio.h>
#include <ctype.h>

char stack[100];
int top = -1;

int priority(char c) {
    if(c == '^') return 3;
    if(c == '*' || c == '/') return 2;
    if(c == '+' || c == '-') return 1;
    return 0;
}

int main() {
    char infix[100], c;
    int i;

    printf("Enter infix expression: ");
    scanf("%99s", infix);

    printf("Postfix expression: ");

    for(i=0; infix[i]!='\0'; i++) {
        c = infix[i];

        if(isalnum((unsigned char)c))
            printf("%c", c);

        else if(c == '(')
            stack[++top] = c;

        else if(c == ')') {
            while(top != -1 && stack[top] != '(')
                printf("%c", stack[top--]);

            if(top != -1)
                top--;
        }

        else {
            while(top != -1 && stack[top] != '(' &&
                 (priority(stack[top]) > priority(c) ||
                 (priority(stack[top]) == priority(c) && c != '^')))
                printf("%c", stack[top--]);

            stack[++top] = c;
        }
    }

    while(top != -1)
        printf("%c", stack[top--]);

    printf("\n");
    return 0;
}
