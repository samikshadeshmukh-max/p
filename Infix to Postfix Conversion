#include <stdio.h>
#include <ctype.h>

char s[100];
int top=-1;

void push(char c) { s[++top]=c; }
char pop() { return s[top--]; }

int priority(char c) {
    if(c=='^') return 3;
    if(c=='*'||c=='/') return 2;
    if(c=='+'||c=='-') return 1;
    return 0;
}

int main() {
    char in[100],c;
    int i;

    printf("Enter infix expression: ");
    scanf("%99s",in);

    for(i=0;in[i];i++) {
        c=in[i];

        if(isalnum((unsigned char)c)) printf("%c",c);
        else if(c=='(') push(c);
        else if(c==')') {
            while(top!=-1 && s[top]!='(') printf("%c",pop());
            if(top!=-1) pop();
        }
        else {
            while(top!=-1 && s[top]!='(' &&
                 (priority(s[top])>priority(c) ||
                 (priority(s[top])==priority(c) && c!='^')))
                printf("%c",pop());

            push(c);
        }
    }

    while(top!=-1) printf("%c",pop());

    return 0;
}
