#include <stdio.h>
#define MAX 20

int g[MAX][MAX], visited[MAX], n;

void dfs(int v) {
    printf("%d ", v);
    visited[v] = 1;

    for(int i=0; i<n; i++) {
        if(g[v][i] == 1 && visited[i] == 0)
            dfs(i);
    }
}

void bfs(int start) {
    int q[MAX], front=0, rear=0;

    for(int i=0; i<n; i++)
        visited[i] = 0;

    q[rear++] = start;
    visited[start] = 1;

    while(front < rear) {
        int v = q[front++];
        printf("%d ", v);

        for(int i=0; i<n; i++) {
            if(g[v][i] == 1 && visited[i] == 0) {
                q[rear++] = i;
                visited[i] = 1;
            }
        }
    }
}

int main() {
    int e, u, v, start;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter number of edges: ");
    scanf("%d", &e);

    printf("Enter edges (u v):\n");

    for(int i=0; i<e; i++) {
        scanf("%d%d", &u, &v);
        g[u][v] = 1;
        g[v][u] = 1;
    }

    printf("\nAdjacency Matrix:\n");
    for(int i=0; i<n; i++) {
        for(int j=0; j<n; j++)
            printf("%d ", g[i][j]);
        printf("\n");
    }

    printf("Enter starting vertex (0 to %d): ", n-1);
    scanf("%d", &start);

    for(int i=0; i<n; i++)
        visited[i] = 0;

    printf("DFS traversal: ");
    dfs(start);

    printf("\nBFS traversal: ");
    bfs(start);

    printf("\n");
    return 0;
}
