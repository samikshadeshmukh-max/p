#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *next;
};

struct Node *head = NULL;

void insert(int x, int pos) {
    struct Node *n = malloc(sizeof(struct Node));
    struct Node *p = head;

    n->data = x;

    if(pos == 1) {
        n->next = head;
        head = n;
        return;
    }

    for(int i=1; p && i<pos-1; i++)
        p = p->next;

    if(!p) {
        printf("Invalid position\n");
        free(n);
        return;
    }

    n->next = p->next;
    p->next = n;
    printf("Node inserted successfully\n");
}

void deleteNode(int pos) {
    struct Node *p = head, *t;

    if(!head) {
        printf("List is empty\n");
        return;
    }

    if(pos == 1) {
        head = head->next;
        free(p);
        printf("Node deleted successfully\n");
        return;
    }

    for(int i=1; p && i<pos-1; i++)
        p = p->next;

    if(!p || !p->next) {
        printf("Invalid position\n");
        return;
    }

    t = p->next;
    p->next = t->next;
    free(t);
    printf("Node deleted successfully\n");
}

void display() {
    struct Node *p = head;

    if(!p) {
        printf("List is empty\n");
        return;
    }

    printf("Linked list: ");
    while(p) {
        printf("%d -> ", p->data);
        p = p->next;
    }
    printf("NULL\n");
}

void reverse() {
    struct Node *prev = NULL, *cur = head, *next;

    while(cur) {
        next = cur->next;
        cur->next = prev;
        prev = cur;
        cur = next;
    }

    head = prev;
    printf("List reversed successfully\n");
}

int main() {
    int ch, x, pos;

    do {
        printf("\n1.Insert\n2.Delete\n3.Display\n4.Reverse\n0.Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &ch);

        switch(ch) {
        case 1:
            printf("Enter value and position: ");
            scanf("%d%d", &x, &pos);
            insert(x, pos);
            break;

        case 2:
            printf("Enter position to delete: ");
            scanf("%d", &pos);
            deleteNode(pos);
            break;

        case 3:
            display();
            break;

        case 4:
            reverse();
            break;

        case 0:
            printf("Exiting...\n");
            break;

        default:
            printf("Invalid choice\n");
        }
    } while(ch != 0);

    return 0;
}
