#include <stdio.h>
#define MAX 100

struct Item {
    int data, priority;
} q[MAX];

int n=0;

void insert(int x,int p) {
    if(n==MAX) {
        printf("Queue full\n");
        return;
    }

    int i=n-1;

    while(i>=0 && q[i].priority>p) {
        q[i+1]=q[i];
        i--;
    }

    q[i+1].data=x;
    q[i+1].priority=p;
    n++;
}

void delete() {
    if(n==0) {
        printf("Queue empty\n");
        return;
    }

    printf("Served: %d\n",q[0].data);

    for(int i=0;i<n-1;i++) q[i]=q[i+1];
    n--;
}

void display() {
    for(int i=0;i<n;i++)
        printf("Item:%d Priority:%d\n",q[i].data,q[i].priority);
}

int main() {
    int ch,x,p;

    do {
        printf("\n1.Insert 2.Delete 3.Display 0.Exit\n");
        scanf("%d",&ch);

        switch(ch) {
        case 1:
            printf("Enter item and priority: ");
            scanf("%d%d",&x,&p);
            insert(x,p);
            break;
        case 2: delete(); break;
        case 3: display(); break;
        }
    } while(ch!=0);

    return 0;
}
