#include <stdio.h>
#define MAX 100

int data[MAX], priority[MAX], n = 0;

void insert(int x, int p) {
    int i;

    if(n == MAX) {
        printf("Queue is full\n");
        return;
    }

    i = n-1;

    while(i >= 0 && priority[i] > p) {
        data[i+1] = data[i];
        priority[i+1] = priority[i];
        i--;
    }

    data[i+1] = x;
    priority[i+1] = p;
    n++;

    printf("Element inserted\n");
}

void deleteItem() {
    if(n == 0) {
        printf("Queue is empty\n");
        return;
    }

    printf("Served element: %d\n", data[0]);

    for(int i=0; i<n-1; i++) {
        data[i] = data[i+1];
        priority[i] = priority[i+1];
    }

    n--;
}

void display() {
    if(n == 0) {
        printf("Queue is empty\n");
        return;
    }

    printf("Elements in priority order:\n");

    for(int i=0; i<n; i++)
        printf("Element: %d Priority: %d\n",
               data[i], priority[i]);
}

int main() {
    int ch, x, p;

    do {
        printf("\n1.Insert\n2.Delete\n3.Display\n0.Exit\n");
        printf("Enter choice: ");
        scanf("%d", &ch);

        switch(ch) {
        case 1:
            printf("Enter element and priority: ");
            scanf("%d%d", &x, &p);
            insert(x, p);
            break;

        case 2:
            deleteItem();
            break;

        case 3:
            display();
            break;

        case 0:
            printf("Exiting...\n");
            break;

        default:
            printf("Invalid choice\n");
        }
    } while(ch != 0);

    return 0;
}
