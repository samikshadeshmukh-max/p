#include <stdio.h>

int main() {
    int a[100], n, i, j, ch, key, pos, t;
    int l, r, mid, found;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for(i=0; i<n; i++)
        scanf("%d", &a[i]);

    do {
        printf("\n1. Bubble Sort");
        printf("\n2. Linear Search");
        printf("\n3. Binary Search");
        printf("\n0. Exit");
        printf("\nEnter choice: ");
        scanf("%d", &ch);

        switch(ch) {
        case 1:
            for(i=0; i<n-1; i++)
                for(j=0; j<n-i-1; j++)
                    if(a[j]>a[j+1]) {
                        t=a[j];
                        a[j]=a[j+1];
                        a[j+1]=t;
                    }

            printf("Sorted array: ");
            for(i=0; i<n; i++)
                printf("%d ", a[i]);
            printf("\n");
            break;

        case 2:
            printf("Enter element to search: ");
            scanf("%d", &key);
            found=0;

            for(i=0; i<n; i++)
                if(a[i]==key) {
                    printf("Found at position %d\n", i+1);
                    found=1;
                    break;
                }

            if(!found)
                printf("Element not found\n");
            break;

        case 3:
            printf("Enter element to search: ");
            scanf("%d", &key);

            l=0;
            r=n-1;
            pos=-1;

            /* Binary search requires sorted elements */
            for(i=0; i<n-1; i++)
                for(j=0; j<n-i-1; j++)
                    if(a[j]>a[j+1]) {
                        t=a[j];
                        a[j]=a[j+1];
                        a[j+1]=t;
                    }

            while(l<=r) {
                mid=(l+r)/2;

                if(a[mid]==key) {
                    pos=mid;
                    break;
                }
                else if(a[mid]<key)
                    l=mid+1;
                else
                    r=mid-1;
            }

            if(pos!=-1)
                printf("Found at position %d\n", pos+1);
            else
                printf("Element not found\n");
            break;

        case 0:
            printf("Exiting...\n");
            break;

        default:
            printf("Invalid choice\n");
        }
    } while(ch!=0);

    return 0;
}
